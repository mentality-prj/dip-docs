{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qdip.ai/schemas/battleverse-preregistration.schema.json",
  "title": "BattleVerse OC1 QDIP Bounded Qualification Preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "protocol_version",
    "freeze_timestamp",
    "qualification_claim_boundary",
    "scenario_set",
    "gold_package_checksums",
    "decision_spec_schema_version",
    "canonical_ir_semantic_version",
    "qdip_runtime_commit",
    "solver_config",
    "llm",
    "prompt_hashes",
    "policy_hashes",
    "scoring",
    "aggregation",
    "missing_output_spec",
    "retry_spec",
    "nr_fail_spec",
    "evaluation_world_spec",
    "human_effort_spec",
    "s1_comparison_thresholds",
    "go_no_go_thresholds",
    "epsilon_semantic",
    "scorer",
    "execution_environment"
  ],
  "properties": {
    "protocol_id": { "type": "string", "const": "battleverse-oc1-llm-decisionspec-bounded-qualification" },
    "protocol_version": { "type": "string", "minLength": 1 },
    "freeze_timestamp": { "type": "string", "format": "date-time" },
    "qualification_claim_boundary": {
      "type": "string",
      "const": "bounded_internal_go_no_go_not_broad_generalization"
    },
    "scenario_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development_scenario_id", "blind_scenarios"],
      "properties": {
        "development_scenario_id": { "type": "string" },
        "blind_scenarios": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenario_id", "scenario_sha256"],
            "properties": {
              "scenario_id": { "type": "string" },
              "scenario_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "gold_package_checksums": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "decision_spec_schema_version": { "type": "string" },
    "canonical_ir_semantic_version": { "type": "string" },
    "qdip_runtime_commit": { "type": "string", "minLength": 7 },
    "solver_config": { "type": "object" },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "version", "decoding"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "version": { "type": "string" },
        "decoding": { "type": "object" }
      }
    },
    "prompt_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s1_sha256", "s2_sha256"],
      "properties": {
        "s1_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "s2_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "policy_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambiguity_policy_sha256", "validator_rules_sha256"],
      "properties": {
        "ambiguity_policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validator_rules_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "scoring": {
      "type": "object",
      "required": ["rubric_version", "failure_taxonomy_version", "full_precision_gate_comparisons"],
      "properties": {
        "rubric_version": { "type": "string" },
        "failure_taxonomy_version": { "type": "string" },
        "full_precision_gate_comparisons": { "const": true }
      }
    },
    "aggregation": { "type": "object" },
    "missing_output_spec": { "type": "object" },
    "retry_spec": { "type": "object" },
    "nr_fail_spec": { "type": "object" },
    "evaluation_world_spec": { "type": "object" },
    "human_effort_spec": { "type": "object" },
    "s1_comparison_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta_ccr_better", "delta_sar_better", "delta_svr_better", "hhc_better_by_count", "min_dimensions_better", "material_regression_forbidden"],
      "properties": {
        "delta_ccr_better": { "const": 0.05 },
        "delta_sar_better": { "const": 0.05 },
        "delta_svr_better": { "const": 0.2 },
        "hhc_better_by_count": { "const": 1 },
        "min_dimensions_better": { "const": 3 },
        "material_regression_forbidden": { "const": true }
      }
    },
    "go_no_go_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ccr_micro_min",
        "ccr_per_scenario_min",
        "hallucinated_hard_constraints_total_max",
        "sar_micro_max",
        "sar_per_scenario_max",
        "hard_constraint_violations_total_max",
        "provenance_accuracy_min",
        "ambiguity_recall_min",
        "human_effort_total_ratio_max",
        "human_effort_per_scenario_ratio_max"
      ],
      "properties": {
        "ccr_micro_min": { "const": 0.95 },
        "ccr_per_scenario_min": { "const": 0.9 },
        "hallucinated_hard_constraints_total_max": { "const": 0 },
        "sar_micro_max": { "const": 0.05 },
        "sar_per_scenario_max": { "const": 0.1 },
        "hard_constraint_violations_total_max": { "const": 0 },
        "provenance_accuracy_min": { "const": 0.95 },
        "ambiguity_recall_min": { "const": 0.9 },
        "human_effort_total_ratio_max": { "const": 0.7 },
        "human_effort_per_scenario_ratio_max": { "const": 1.25 }
      }
    },
    "epsilon_semantic": { "const": 0.05 },
    "scorer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_commit", "fixture_version", "fixture_checksums", "tests_passed"],
      "properties": {
        "code_commit": { "type": "string", "minLength": 7 },
        "fixture_version": { "type": "string" },
        "fixture_checksums": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "tests_passed": { "const": true }
      }
    },
    "execution_environment": { "type": "object" }
  }
}